50726, "full_name": "Jiazheng Cai", "first_name": "Jiazheng", "last_name": "Cai", "is_active": true, "url_name": "Jiazheng_Cai", "orcid_id": "0009-0008-5148-1787"}, {"id": 23012002, "full_name": "Xue", "first_name": "", "last_name": "Xue", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 23104366, "full_name": "Stian Tornaas", "first_name": "Stian", "last_name": "Tornaas", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 23104360, "full_name": "Harsh Dongre", "first_name": "Harsh", "last_name": "Dongre", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-4378-2869"}, {"id": 23104368, "full_name": "Athanasia Bletsa", "first_name": "Athanasia", "last_name": "Bletsa", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 23104369, "full_name": "Sigbj\u00f8rn L\u00f8es", "first_name": "Sigbj\u00f8rn", "last_name": "L\u00f8es", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 23104370, "full_name": "Peter Schleier", "first_name": "Peter", "last_name": "Schleier", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 23104373, "full_name": "Evelyn Neppelberg", "first_name": "Evelyn", "last_name": "Neppelberg", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 23104376, "full_name": "Arild Kvalheim", "first_name": "Arild", "last_name": "Kvalheim", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 23104378, "full_name": "Ellen Berggreen", "first_name": "Ellen", "last_name": "Berggreen", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 23104380, "full_name": "Daniela-Elena Costea", "first_name": "Daniela-Elena", "last_name": "Costea", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 22451022, "full_name": "Zhe Xing", "first_name": "Zhe", "last_name": "Xing", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 22451026, "full_name": "Anca Virtej", "first_name": "Anca", "last_name": "Virtej", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://figshare.com/articles/dataset/Raw_Data_and_Supplementary_Data_of_b_Imaging_Mass_Cytometry_Unveils_Functional_and_Spatial_Remodeling_b_b_b_b_of_Peri-lesional_Cells_in_Jaw_Osteonecrosis_b_/30383407", "download_disabled": false, "description": "<p dir=\"ltr\">Medication-related osteonecrosis of the jaw (MRONJ) is a severe complication associated with antiresorptive therapy, characterized by compromised bone and soft tissue integrity. However, the underlying tissue-level mechanisms remain poorly understood. To uncover cell functions and spatial organization surrounding ONJ lesions, imaging mass cytometry is used to profile lesions at single-cell resolution across epithelial, stromal, and vascular regions. Widespread immune infiltration is observed, with regulatory T cells, M2-like macrophages, exhausted T cells, and natural killer cells shifting from dispersed to clustered spatial patterns, indicating altered immune organization. Epithelial regions show reduced epithelial marker expression and disrupted architecture despite elevated proliferation-related markers, while fibroblasts and endothelial cells display signs of activation. Functional profiling reveals concurrent proliferative, apoptotic, and stress-associated signatures across multiple cell populations. This comprehensive spatial and functional atlas provides insights into the pathophysiology of MRONJ and may inform future therapeutic strategies aimed at restoring tissue homeostasis and promoting effective healing.</p>", "funding": "Helse Vest (Project No. 912222)", "funding_list": [{"id": 29254285, "title": "Helse Vest (Project No. 912222)", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 29254288, "title": "The Research Council of Norway (No. 22325)", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 29254291, "title": "Helse Vest (Project No. F-13105)", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 29305150, "title": "Helse Vest (Project No. 102728)", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 6868922827, "created_date": "2026-02-12T19:14:17Z", "modified_date": "2026-02-13T10:51:07Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["Osteonecrosis of the Jaw", "imaging mass cytometry (IMC)"], "keywords": ["Osteonecrosis of the Jaw", "imaging mass cytometry (IMC)"], "categories": [{"id": 24583, "title": "Oral medicine and pathology", "parent_id": 24562, "path": "/24457/24562/24583", "source_id": "320307", "taxonomy_id": 100}], "references": ["https://doi.org/10.1038/s42003-026-09696-7"], "has_linked_file": false, "citation": "Cai, Jiazheng; Xue; Tornaas, Stian; Dongre, Harsh; Bletsa, Athanasia; L\u00f8es, Sigbj\u00f8rn; et al. (2026). Raw Data and Supplementary Data of <b>Imaging Mass Cytometry Unveils Functional and Spatial Remodeling</b><b> </b><b>of Peri-lesional Cells in Jaw Osteonecrosis</b>. figshare. Dataset. https://doi.org/10.6084/m9.figshare.30383407.v1", "related_materials": [{"id": 271091056, "identifier": "10.1038/s42003-026-09696-7", "title": "", "relation": "IsSupplementTo", "identifier_type": "DOI", "is_linkout": false, "link": "https://doi.org/10.1038/s42003-026-09696-7"}], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 30383407, "title": "Raw Data and Supplementary Data of <b>Imaging Mass Cytometry Unveils Functional and Spatial Remodeling</b><b> </b><b>of Peri-lesional Cells in Jaw Osteonecrosis</b>", "doi": "10.6084/m9.figshare.30383407.v1", "handle": "", "url": "https://api.figshare.com/v2/articles/30383407", "published_date": "2026-02-12T19:14:17Z", "thumb": "https://s3-eu-west-1.amazonaws.com/pfigshare-u-previews/61516465/thum